# Claude: the agent's model. Required for real runs; `nexus run <scenario> --fake` needs nothing.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
# Tool-loop budget. Running out means insufficient_evidence, which means the standard offer.
AGENT_MAX_TURNS=10

# Remediation credit and the standard offer live in backend/config/business.toml

# Live apps (filled in once accounts exist)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=mergeline-sync
DATADOG_API_KEY=
DATADOG_APP_KEY=
DATADOG_SITE=datadoghq.com
MIXPANEL_PROJECT_ID=
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_SERVICE_ACCOUNT_USER=
MIXPANEL_SERVICE_ACCOUNT_SECRET=
# api (US) | api-eu | api-in
MIXPANEL_REGION=api
SENTRY_DSN=
STRIPE_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173,http://localhost:8000
